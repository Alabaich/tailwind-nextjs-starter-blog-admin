# Keep the compose project name stable — the deployer runs `docker compose`
# from inside its container and must target the same project.
COMPOSE_PROJECT_NAME=bluegreen-blog

# Ports on the host
BLOG_PORT=8080
ADMIN_PORT=8081

# Interface the admin port is published on. Loopback by default because the
# bundled Caddyfile serves the admin over plain HTTP. Reach it through an SSH
# tunnel, or put it behind TLS first (README > Production notes) and only then
# switch this to 0.0.0.0.
ADMIN_BIND=127.0.0.1

# Admin login. Seeded into SQLite on first boot only — changing these later
# does not change the existing account. The password needs 12+ characters;
# setup.sh generates one for you.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Secrets — setup.sh fills these with random values. The services refuse to
# start with the placeholders or with anything shorter than 32 characters.
SESSION_SECRET=replace-with-random-hex
DEPLOY_TOKEN=replace-with-random-hex

# Optional
# MAX_UPLOAD_MB=8
