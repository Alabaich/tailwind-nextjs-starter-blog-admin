# Keep the compose project name stable — the deployer runs `docker compose`
# from inside its container and must target the same project.
COMPOSE_PROJECT_NAME=bluegreen-blog

# Ports on the host
BLOG_PORT=8080
ADMIN_PORT=8081

# Admin login (seeded into SQLite on first boot)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Secrets — setup.sh fills these with random values
SESSION_SECRET=replace-with-random-hex
DEPLOY_TOKEN=replace-with-random-hex
